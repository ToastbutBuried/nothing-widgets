<?xml version="1.0" encoding="utf-8"?>
<!-- art_root is how GestureService finds this widget on the home screen (by view id), keep the id stable. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/art_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:contentDescription="Artwork widget">
    <ImageView android:id="@+id/img" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" />
    <!-- mini dot eq, animated by the launcher itself (indeterminate ProgressBar runs the animated vector);
         shown only while playing on the cover side. Generated by tools/gen_eq.py -->
    <ProgressBar android:id="@+id/eq" android:layout_width="21.1dp" android:layout_height="26.8dp"
        android:layout_gravity="bottom|start" android:layout_marginStart="21dp" android:layout_marginBottom="17dp"
        android:indeterminate="true" android:indeterminateOnly="true"
        android:indeterminateDrawable="@drawable/eq_anim" android:visibility="gone" />
</FrameLayout>
